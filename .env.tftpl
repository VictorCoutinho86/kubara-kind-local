# kubara environment - generated by Terraform.
# Values are rendered from terraform variables. Edit terraform.tfvars, not this file.

# Project related values
PROJECT_NAME="${project_name}"
PROJECT_STAGE="${project_stage}"

# Argo CD related values
ARGOCD_WIZARD_ACCOUNT_PASSWORD="${argocd_password}"

# Git repository values
# The HTTPS URL of the git repository that Argo CD will use to pull the kubara generated manifests from.
ARGOCD_GIT_HTTPS_URL="${repo_url}"

# Optional: Git repository credentials for Argo to pull your kubara manifests from.
# Necessary if your repository isn't public.
ARGOCD_GIT_USERNAME="${git_username}"
ARGOCD_GIT_PAT_OR_PASSWORD="${git_pat}"

# Optional: Helm repository values (leave empty to disable).
ARGOCD_HELM_REPO_USERNAME=""
ARGOCD_HELM_REPO_PASSWORD=""
ARGOCD_HELM_REPO_URL=""

# Optional: Container Registry Config (base64 encoded dockerconfigjson).
DOCKERCONFIG_BASE64=""
